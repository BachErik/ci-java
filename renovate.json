{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Keep each JDK on its LTS line (21 stays 21, 25 stays 25); same for Node 26",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin", "node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "JDK/Node patch bumps can go straight in",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["eclipse-temurin", "node"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
